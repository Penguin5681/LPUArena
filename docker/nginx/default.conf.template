server {
  listen __PORT__;
  listen [::]:__PORT__;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Vite SPA fallback: route unknown paths to index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Cache immutable static build assets aggressively.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
}
